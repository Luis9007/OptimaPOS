# =====================================================================
# OPTIMA POS v2.0 - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =====================================================================

# ---------------------------------------------------------------------
# 1. BASE DE DATOS Y AUTENTICACIÓN (SUPABASE)
# ---------------------------------------------------------------------
# Obtén estas credenciales desde tu panel de Supabase:
# Project Settings -> API -> Project URL & Project API Keys (anon public)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ---------------------------------------------------------------------
# 2. ALMACENAMIENTO DE COMPROBANTES Y LOGOS (CLOUDFLARE R2)
# ---------------------------------------------------------------------
# Obtén estas credenciales desde tu panel de Cloudflare:
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Token

# ID de tu cuenta de Cloudflare
VITE_R2_ACCOUNT_ID=tu_account_id_aqui

# Clave de acceso S3 (Access Key ID)
VITE_R2_ACCESS_KEY_ID=tu_access_key_id_aqui

# Clave secreta S3 (Secret Access Key)
VITE_R2_SECRET_ACCESS_KEY=tu_secret_access_key_aqui

# Nombre exacto de tu bucket en Cloudflare R2
VITE_R2_BUCKET_NAME=optimapos-comprobantes

# Dominio público asignado al bucket en R2 (R2 Public Domain o Custom Subdomain)
VITE_R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev

# Puerto del servidor backend Express (Opcional, defecto 3001)
PORT=3001
