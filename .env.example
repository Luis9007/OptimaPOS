# =====================================================================
# STOREFLOW v2.0 - CONFIGURACIÓN DE ALMACENAMIENTO EN CLOUDFLARE R2
# =====================================================================
# Obtén estas credenciales desde tu panel de Cloudflare:
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Token

# 1. ID de tu cuenta de Cloudflare
VITE_R2_ACCOUNT_ID=tu_account_id_aqui

# 2. Clave de acceso S3 (Access Key ID)
VITE_R2_ACCESS_KEY_ID=tu_access_key_id_aqui

# 3. Clave secreta S3 (Secret Access Key)
VITE_R2_SECRET_ACCESS_KEY=tu_secret_access_key_aqui

# 4. Nombre exacto de tu bucket en Cloudflare R2
VITE_R2_BUCKET_NAME=storeflow-comprobantes

# 5. Dominio público asignado al bucket en R2 (R2 Public Domain o Custom Subdomain)
VITE_R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev
